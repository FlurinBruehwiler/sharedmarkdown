{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Admin": {
    "Password": ""
  },
  "Backups": {
    "Keep": 14
  },
  "KnownProxies": [],
  "Limits": {
    "DocumentsPerIpPerHour": 100,
    "MaxDocumentChars": 50000,
    "MaxDocumentItems": 500000,
    "UploadsPerIpPerHour": 100,
    "MaxUploadBytes": 10485760,
    "MaxImageDimension": 2000,
    "MaxConnectionsPerIp": 30,
    "JoinsPerIpPerMinute": 120,
    "SubmitsPerIpPerMinute": 1200,
    "TitleLookupsPerIpPerMinute": 120,
    "AdminLoginAttemptsPerIpPerHour": 10
  }
}
