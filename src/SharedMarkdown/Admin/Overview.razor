@page "/admin"
@attribute [Authorize]
@inject IDbContextFactory<AppDb> DbFactory
@inject DocStore Store
@inject IpGuard Guard
@inject Paths Paths
@inject Maintenance Maintenance
@inject ServerMetrics Metrics
@implements IDisposable

<h2>Overview</h2>

@{ var history = Metrics.History(); }
<div class="cards">
    @Rate("HTTP requests/s", "Page loads, images, API calls", history, h => h.RequestsPerSecond)
    @Rate("SignalR in/s", "Hub calls from browsers: edits, cursor moves, joins", history, h => h.HubInPerSecond)
    @Rate("SignalR out/s", "Messages sent to browsers: relayed edits, cursors, presence (one per recipient)", history, h => h.HubOutPerSecond)
</div>
<p class="muted">Averaged over 10 s; the lines show the last hour. Refreshes every 10 s.</p>

@if (_s is { } s)
{
    <div class="cards">
        <div class="card"><b>@s.Documents.ToString("N0")</b><span>documents</span></div>
        <div class="card"><b>@s.Documents24h.ToString("N0")</b><span>created in the last 24 h</span></div>
        <div class="card"><b>@Fmt.Bytes(s.TextBytes)</b><span>of text</span></div>
        <div class="card"><b>@s.Images.ToString("N0")</b><span>images (@Fmt.Bytes(s.ImageBytes))</span></div>
        <div class="card"><b>@s.Images24h.ToString("N0")</b><span>images uploaded in 24 h</span></div>
        <div class="card"><b>@Fmt.Bytes(s.DbBytes)</b><span>database file</span></div>
        <div class="card"><b>@Guard.Connections</b><span>open connections</span></div>
        <div class="card"><b>@Store.LiveCount</b><span>documents in memory</span></div>
        <div class="card"><b>@s.Blocked</b><span>blocked IPs</span></div>
        <div class="card"><b>@(s.LastBackup is { } b ? Fmt.Time(b) : "never")</b><span>last backup</span></div>
    </div>

    <h3>Most documents created in the last 24 h</h3>
    <IpTable Rows="s.TopCreators" Unit="documents" />

    <h3>Most images uploaded in the last 24 h</h3>
    <IpTable Rows="s.TopUploaders" Unit="images" />
}
else
{
    <p class="muted">Loading…</p>
}

@code {
    record Stats(int Documents, int Documents24h, long TextBytes, int Images, int Images24h, long ImageBytes, long DbBytes, int Blocked, DateTime? LastBackup,
        List<(string Ip, int Count)> TopCreators, List<(string Ip, int Count)> TopUploaders);
    Stats? _s;
    Timer? _timer;

    protected override void OnInitialized() =>
        _timer = new Timer(_ => InvokeAsync(StateHasChanged), null, TimeSpan.FromSeconds(10), TimeSpan.FromSeconds(10));

    public void Dispose() => _timer?.Dispose();

    static RenderFragment Rate(string label, string explanation, List<MetricSample> history, Func<MetricSample, double> pick) => __builder =>
    {
        var values = history.Select(pick).ToList();
        var peak = values.DefaultIfEmpty().Max();
        <div class="card" title="@explanation">
            <span>@label</span>
            <b>@PerSecond(values.LastOrDefault())</b>
            <span>peak @PerSecond(peak) in the last hour</span>
            <Sparkline Values="values" Times="history.Select(h => h.Time).ToList()" Max="Math.Max(peak, 1)" Format="PerSecond" />
        </div>
    };

    static string PerSecond(double v) => v < 10 ? v.ToString("0.#") : v.ToString("N0");

    protected override async Task OnInitializedAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var since = DateTime.UtcNow.AddHours(-24);
        var creators = await db.Documents.Where(d => d.CreatedAt > since).GroupBy(d => d.CreatorIp)
            .Select(g => new { Ip = g.Key, Count = g.Count() }).OrderByDescending(x => x.Count).Take(10).ToListAsync();
        var uploaders = await db.Blobs.Where(b => b.CreatedAt > since).GroupBy(b => b.UploaderIp)
            .Select(g => new { Ip = g.Key, Count = g.Count() }).OrderByDescending(x => x.Count).Take(10).ToListAsync();
        var dbBytes = new[] { "", "-wal" }.Select(f => new FileInfo(Paths.Database + f)).Where(f => f.Exists).Sum(f => f.Length);
        _s = new Stats(
            await db.Documents.CountAsync(),
            await db.Documents.CountAsync(d => d.CreatedAt > since),
            await db.Documents.SumAsync(d => (long)d.Content.Length),
            await db.Blobs.CountAsync(),
            await db.Blobs.CountAsync(b => b.CreatedAt > since),
            await db.Blobs.SumAsync(b => (long)b.Data.Length),
            dbBytes,
            await db.BlockedIps.CountAsync(),
            Maintenance.ListBackups().FirstOrDefault()?.CreatedUtc,
            creators.Select(x => (x.Ip, x.Count)).ToList(),
            uploaders.Select(x => (x.Ip, x.Count)).ToList());
    }
}
