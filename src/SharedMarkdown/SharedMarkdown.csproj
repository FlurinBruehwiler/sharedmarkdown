<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <ClientDir>$(MSBuildProjectDirectory)/../client</ClientDir>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SharedMarkdown.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.App.Internal.Assets" Version="11.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.11">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.11" />
    <PackageReference Include="Serilog.AspNetCore" Version="11.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageReference Include="SkiaSharp" Version="4.157.0" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="4.157.0" />
  </ItemGroup>

  <ItemGroup>
    <ClientSource Include="$(ClientDir)/src/**;$(ClientDir)/public/**;$(ClientDir)/index.html;$(ClientDir)/build.mjs;$(ClientDir)/package.json;$(ClientDir)/tsconfig.json" />
    <None Update="app.html" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <!--
    The frontend (../client) builds into wwwroot/ (served by MapStaticAssets, which fingerprints and
    compresses it) and app.html (served by AppShell.cs). It runs before the SDK collects static assets,
    and declares its outputs itself so even a first build, before they exist, picks them up.
  -->
  <Target Name="NpmInstall" BeforeTargets="BuildClient" Condition="!Exists('$(ClientDir)/node_modules')">
    <Exec Command="npm ci" WorkingDirectory="$(ClientDir)" />
  </Target>
  <Target Name="BuildClient" BeforeTargets="BeforeBuild" Inputs="@(ClientSource)" Outputs="app.html;wwwroot/assets/app.js;wwwroot/sw.js">
    <Exec Command="node build.mjs" WorkingDirectory="$(ClientDir)" />
  </Target>
  <Target Name="IncludeClientOutput" AfterTargets="BuildClient">
    <ItemGroup>
      <ClientPublic Include="$(ClientDir)/public/**" />
      <ClientOutput Include="wwwroot/assets/**;wwwroot/sw.js;@(ClientPublic->'wwwroot/%(RecursiveDir)%(Filename)%(Extension)')" />
      <Content Remove="@(ClientOutput)" />
      <Content Include="@(ClientOutput)" />
      <None Remove="app.html" />
      <None Include="app.html" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>

</Project>
